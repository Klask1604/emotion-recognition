    {
      "id": 10,
      "type": "text",
      "title": "READ ME",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**WESAD valence model, observed-only.** The same model + extractor used by the production fusion channel, but here it is logged side-by-side with the verdict - it does **NOT** feed `biofizic/state`. Purpose: judge how well the 85% LOSO model transfers to the watch before trusting it. `valence_z` > 0 = positive (amusement-like), < 0 = negative (stress-like). To validate: induce a known state (e.g. funny clip vs stressor) and check the sign/level here. Enable with `ENABLE_VALENCE_WESAD = True` in `affectus/legacy/toggles.py` (local research build only)."
      }
    },
    {
      "id": 1,
      "title": "WESAD valence z [-1,1]  (>0 positive · <0 negative)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "biofizic-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "biofizic-influx"
          },
          "editorMode": "code",
          "format": "time_series",
          "queryType": "sql",
          "rawQuery": true,
          "rawSql": "SELECT time, valence_z FROM biofizic_legacy_valence_wesad WHERE $__timeFilter(time) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "gradientMode": "scheme"
          },
          "min": -1,
          "max": 1,
          "decimals": 2,
