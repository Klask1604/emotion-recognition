      "description": "Valenta de REFERINTA a scenei (ce PROPUNE scena, nu ce simte userul). Calculata din lumina + culoare + miscare, regula transparenta pe server.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 1,
          "min": -1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": -1 },
              { "color": "yellow", "value": -0.15 },
              { "color": "green", "value": 0.15 }
            ]
          },
          "unit": "none",
          "decimals": 2
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "biofizic-influx" },
          "rawSql": "SELECT time, GREATEST(-1, LEAST(1, (light - 0.5) * 1.2 + ((g + b) / 2.0 - r) * 0.8 - motion * 0.5)) AS \"Valenta scena\" FROM biofizic_context WHERE $__timeFilter(time) AND light IS NOT NULL ORDER BY time",
          "format": "table"
        }
      ],
      "title": "Valenta scenei (referinta)",
      "type": "stat"
    },
